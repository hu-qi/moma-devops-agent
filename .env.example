# ==============================================================================
# DevOpsPilot Environment Variables Configuration Template
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Code Hosting Platform Credentials
# ------------------------------------------------------------------------------
# AtomGit Personal Access Token (for atomgit.com repositories)
# ATOMGIT_TOKEN="your_atomgit_personal_access_token_here"

# GitHub Personal Access Token (for github.com repositories)
# GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# CNB Token (for cnb.cool repositories)
# CNB_TOKEN="cnb_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 2. AI Model & Inference Service Credentials
# ------------------------------------------------------------------------------
# MoMA / DeepSeek / OpenAI Compatible Inference API Key
# MOMA_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# MOMA_BASE_URL="https://api.deepseek.com/v1"

# ------------------------------------------------------------------------------
# 3. Local Runtime & Database Paths (Optional)
# ------------------------------------------------------------------------------
# DEVOPSPILOT_DB_PATH=".devopspilot/state.db"

# ------------------------------------------------------------------------------
# 4. Branding & Portal Navigation URLs (Optional - Leave blank to disable links)
# ------------------------------------------------------------------------------
# DEVOPSPILOT_URL="https://atomgit.com/huqi/moma-devops-agent"
# MOMA_URL="https://ecloud.10086.cn/portal/product/MaaS"
# DEVOPSPILOT_ENABLE_BRAND_LINKS="true"


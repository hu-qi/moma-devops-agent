{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devopspilot.local/schemas/benchmark-case.schema.json",
  "title": "DevOpsBench BenchmarkCase",
  "type": "object",
  "required": [
    "id",
    "version",
    "category",
    "title",
    "task",
    "fixture",
    "constraints",
    "oracle",
    "budget",
    "risk",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "coding",
        "code-review",
        "ci-debug",
        "test-generation",
        "dependency-debug",
        "release-risk"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "max_changed_files": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "read_only": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "precondition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "command",
            "expected_exit_code"
          ],
          "properties": {
            "type": {
              "const": "command-exit"
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "expected_exit_code": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "path",
            "contains"
          ],
          "properties": {
            "type": {
              "const": "file-contains"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "contains": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "oracle": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "command",
            "expected_exit_code"
          ],
          "properties": {
            "type": {
              "const": "command-exit"
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "expected_exit_code": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "required_findings"
          ],
          "properties": {
            "type": {
              "const": "structured-review"
            },
            "required_findings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "budget": {
      "type": "object",
      "required": [
        "timeout_seconds"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "industry": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "license"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
